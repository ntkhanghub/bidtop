# App runtime — Supabase JS client (see lib/supabase/server.ts). From the Supabase
# dashboard: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, bypasses RLS entirely. Never expose to the browser, never
# prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dev tooling only (scripts/apply-migration.mjs) — applies raw SQL in
# supabase/migrations/ and supabase/seed.sql directly, not used by the app itself.
# Use the dedicated "prisma" DB role, not "postgres" (see docs/specs/tech-spec.md).
# Host needs a pooler cluster prefix (e.g. "aws-0-") — the bare region name alone
# (ap-southeast-1.pooler.supabase.com) does not resolve, and the cluster number
# isn't always "aws-0" — copy the exact string from the Supabase dashboard's Connect
# panel rather than guessing; if it fails to resolve/connect, try aws-1-, aws-2-, etc.
DATABASE_URL="postgresql://prisma.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://prisma.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 9Pay merchant credentials (see docs/specs/tech-spec.md Open questions — confirm exact field names in Sprint 3)
NINE_PAY_MERCHANT_KEY=
NINE_PAY_SECRET_KEY=

# Claude API — used for AI category classification on submit (Sprint 2)
ANTHROPIC_API_KEY=
