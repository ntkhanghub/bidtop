# Supabase Postgres — use the dedicated "prisma" DB role, not "postgres" (see
# docs/specs/tech-spec.md). Host needs a pooler cluster prefix (e.g. "aws-0-") — the
# bare region name alone (ap-southeast-1.pooler.supabase.com) does not resolve. The
# cluster number isn't always "aws-0" — copy the exact string from the Supabase
# dashboard's Connect panel rather than guessing; if it fails to resolve/connect, try
# aws-1-, aws-2-, etc. for the same region.
# Pooled connection (runtime queries, port 6543):
DATABASE_URL="postgresql://prisma.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, via the same pooler host in session mode (Prisma Migrate only, port 5432):
DIRECT_URL="postgresql://prisma.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 9Pay merchant credentials (see docs/specs/tech-spec.md Open questions — confirm exact field names in Sprint 3)
NINE_PAY_MERCHANT_KEY=
NINE_PAY_SECRET_KEY=

# Claude API — used for AI category classification on submit (Sprint 2)
ANTHROPIC_API_KEY=
