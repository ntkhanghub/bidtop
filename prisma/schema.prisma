generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  draft
  pending_payment
  paid_pending_review
  approved
  rejected
}

enum BidStatus {
  pending
  confirmed
  failed
}

enum AdminRole {
  admin
  super_admin
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameVi    String    @map("name_vi")
  sortOrder Int       @map("sort_order")
  listings  Listing[]

  @@map("categories")
}

// identity_key is the canonical, normalized domain/path or @handle — see
// docs/specs/tech-spec.md "Data model" and lib/normalize-identity.ts (Sprint 2).
model Listing {
  id               String        @id @default(cuid())
  identityKey      String        @unique @map("identity_key")
  displayUrl       String        @map("display_url")
  categoryId       String        @map("category_id")
  category         Category      @relation(fields: [categoryId], references: [id])
  status           ListingStatus @default(draft)
  // Only the 9Pay IPN webhook handler may write this field, via
  // `amount = amount + delta` inside a transaction — see CLAUDE.md Safety rules.
  amount           Int           @default(0)
  // Set once, on this listing's first confirmed payment. Never updated by a later
  // top-up. Used as the leaderboard tie-break (ORDER BY amount DESC, firstConfirmedAt ASC).
  firstConfirmedAt DateTime?     @map("first_confirmed_at")
  submitterEmail   String        @map("submitter_email")
  rejectionReason  String?       @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  bids             Bid[]

  @@index([status, amount, firstConfirmedAt])
  @@index([categoryId, status, amount, firstConfirmedAt])
  @@map("listings")
}

// Append-only payment ledger — one row per checkout attempt. Doubles as the
// audit trail for the revenue counter (F13): SUM(totalCharged) WHERE status = confirmed.
model Bid {
  id             String    @id @default(cuid())
  listingId      String    @map("listing_id")
  listing        Listing   @relation(fields: [listingId], references: [id])
  deltaAmount    Int       @map("delta_amount")
  vatAmount      Int       @map("vat_amount")
  totalCharged   Int       @map("total_charged")
  gatewayOrderId String    @unique @map("gateway_order_id")
  gatewayTxnId   String?   @map("gateway_txn_id")
  status         BidStatus @default(pending)
  createdAt      DateTime  @default(now()) @map("created_at")
  confirmedAt    DateTime? @map("confirmed_at")

  @@map("bids")
}

// Runtime-configurable pricing (F9, super_admin only): starting_price, min_increment, vat_percent.
model Setting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}
